# Sesiones. Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL pública de la app (links de invitación).
APP_URL=http://localhost:3000

# Postgres. Si se deja vacío en desarrollo, se usa una base embebida en .data/
DATABASE_URL=

# Email (Resend). Sin RESEND_API_KEY en desarrollo, los emails se imprimen en la terminal.
RESEND_API_KEY=
# Dirección que manda los emails; el nombre que se muestra sale de BRAND.
EMAIL_FROM=no-reply@mail.clipfleet.app
